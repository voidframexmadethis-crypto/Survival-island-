      // -------------------------------------------------------------------
      // 2. WEB AUDIO API ENGINE (ZERO EXTERNAL DEPENDENCIES)
      // -------------------------------------------------------------------
      let audioCtx = null;
      let masterGain = null;
      let analyserNode = null;
      let freqDataArray = null;
      let timeDataArray = null;
      let mixerGainNodes = [];
      let mixerPanNodes = [];

      function showToast(msg) {
        const toast = document.getElementById('statusToast');
        const text = document.getElementById('statusToastText');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(showToast._timer);
        showToast._timer = setTimeout(() => {
          toast.classList.add('hidden');
        }, 2800);
      }

      function initAudioEngine() {
        try {
          if (!audioCtx) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContextClass();

            masterGain = audioCtx.createGain();
            masterGain.gain.value = state.masterVolume;

            analyserNode = audioCtx.createAnalyser();
            analyserNode.fftSize = 256;
            analyserNode.smoothingTimeConstant = 0.78;

            freqDataArray = new Uint8Array(analyserNode.frequencyBinCount);
            timeDataArray = new Uint8Array(analyserNode.fftSize);

            // Build 8 mixer bus channels feeding masterGain -> analyserNode -> destination
            mixerGainNodes = [];
            mixerPanNodes = [];
            for (let i = 0; i < state.mixerStrips.length; i++) {
              const strip = state.mixerStrips[i];
              const gNode = audioCtx.createGain();
              gNode.gain.value = strip.mute ? 0 : strip.vol;

              const pNode = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;
              if (pNode) {
                pNode.pan.value = strip.pan;
                gNode.connect(pNode);
                pNode.connect(masterGain);
              } else {
                gNode.connect(masterGain);
              }
              mixerGainNodes.push(gNode);
              mixerPanNodes.push(pNode);
            }

            masterGain.connect(analyserNode);
            analyserNode.connect(audioCtx.destination);
          }

          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }

          const badge = document.getElementById('audioCtxBadge');
          if (badge) {
            badge.textContent = 'AUDIO: LIVE';
            badge.className = 'text-emerald-400';
          }
        } catch (err) {
          showToast('Web Audio initialization fallback active');
        }
      }

      function syncMixerNodes() {
        if (!audioCtx) return;
        if (masterGain) {
          masterGain.gain.setTargetAtTime(state.masterVolume, audioCtx.currentTime, 0.015);
        }
        state.mixerStrips.forEach((strip, idx) => {
          const gNode = mixerGainNodes[idx];
          const pNode = mixerPanNodes[idx];
          if (gNode) {
            gNode.gain.setTargetAtTime(strip.mute ? 0 : strip.vol, audioCtx.currentTime, 0.015);
          }
          if (pNode) {
            pNode.pan.setTargetAtTime(strip.pan, audioCtx.currentTime, 0.015);
          }
        });
      }

      function hasAnySolo() {
        return state.channels.some((c) => c.solo);
      }

      function isChannelAudible(channel) {
        if (channel.mute) return false;
        if (hasAnySolo() && !channel.solo) return false;
        return true;
      }

      /**
       * Synthesizes or plays a custom buffer for a given channel or browser item
       */
      function triggerSound(opts = {}) {
        initAudioEngine();
        if (!audioCtx) return;

        const {
          synthType = 'pluck',
          freq = 440,
          vol = 0.8,
          pan = 0,
          mixerTrack = 0,
          sampleName = null
        } = opts;

        const now = audioCtx.currentTime;
        const targetBus = mixerGainNodes[mixerTrack % mixerGainNodes.length] || masterGain;

        const voiceGain = audioCtx.createGain();
        const voicePan = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;
        if (voicePan) {
          voicePan.pan.setValueAtTime(Math.max(-1, Math.min(1, pan)), now);
          voiceGain.connect(voicePan);
          voicePan.connect(targetBus);
        } else {
          voiceGain.connect(targetBus);
        }

        // Bump visual peak meter on target mixer channel
        const strip = state.mixerStrips[mixerTrack % state.mixerStrips.length];
        if (strip) {
          strip.peak = Math.min(1, Math.max(strip.peak, vol * 0.95));
        }

        // If a real imported AudioBuffer matches, play it
        if (sampleName && state.customAudioBuffers[sampleName]) {
          const src = audioCtx.createBufferSource();
          src.buffer = state.customAudioBuffers[sampleName];
          voiceGain.gain.setValueAtTime(vol, now);
          src.connect(voiceGain);
          src.start(now);
          return;
        }

        if (synthType === 'kick') {
          const osc = audioCtx.createOscillator();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(Math.max(85, freq * 2.4), now);
          osc.frequency.exponentialRampToValueAtTime(Math.max(28, freq * 0.65), now + 0.16);

          voiceGain.gain.setValueAtTime(vol * 1.15, now);
          voiceGain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

          osc.connect(voiceGain);
          osc.start(now);
          osc.stop(now + 0.23);
        } else if (synthType === '808') {
          const osc = audioCtx.createOscillator();
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(420, now);

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq * 1.2, now);
          osc.frequency.exponentialRampToValueAtTime(freq, now + 0.04);

          voiceGain.gain.setValueAtTime(vol, now);
          voiceGain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

          osc.connect(filter);
          filter.connect(voiceGain);
          osc.start(now);
          osc.stop(now + 0.46);
        } else if (synthType === 'snare' || synthType === 'hat' || synthType === 'openhat' || synthType === 'perc') {
          // Noise burst synthesis
          const duration = synthType === 'openhat' ? 0.24 : synthType === 'hat' ? 0.055 : 0.14;
          const bufferSize = Math.max(1, Math.floor(audioCtx.sampleRate * duration));
          const noiseBuf = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const data = noiseBuf.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }

          const noise = audioCtx.createBufferSource();
          noise.buffer = noiseBuf;

          const filter = audioCtx.createBiquadFilter();
          if (synthType === 'snare') {
            filter.type = 'bandpass';
            filter.frequency.setValueAtTime(freq * 6, now);
            filter.Q.setValueAtTime(1.2, now);
          } else {
            filter.type = 'highpass';
            filter.frequency.setValueAtTime(Math.min(12000, freq), now);
          }

          voiceGain.gain.setValueAtTime(vol * 0.75, now);
          voiceGain.gain.exponentialRampToValueAtTime(0.001, now + duration);

          noise.connect(filter);
          filter.connect(voiceGain);
          noise.start(now);
          noise.stop(now + duration + 0.01);
        } else {
          // Melodic pluck / lead
          const osc = audioCtx.createOscillator();
          const filter = audioCtx.createBiquadFilter();
          osc.type = synthType === 'lead' ? 'sawtooth' : 'triangle';
          osc.frequency.setValueAtTime(freq, now);

          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(freq * 4, now);
          filter.frequency.exponentialRampToValueAtTime(Math.max(180, freq * 1.1), now + 0.24);

          voiceGain.gain.setValueAtTime(vol * 0.55, now);
          voiceGain.gain.exponentialRampToValueAtTime(0.001, now + 0.26);

          osc.connect(filter);
          filter.connect(voiceGain);
          osc.start(now);
          osc.stop(now + 0.27);
        }
      }

      function triggerChannel(channelIndex) {
        const ch = state.channels[channelIndex];
        if (!ch || !isChannelAudible(ch)) return;
        triggerSound({
          synthType: ch.synthType,
          freq: ch.freq,
          vol: ch.vol,
          pan: ch.pan,
          mixerTrack: ch.mixerTrack,
          sampleName: ch.sampleName || null
        });
      }

      // -------------------------------------------------------------------
      // 3. LOCAL FILE IMPORT (.WAV, .MP3, .MID)
      // -------------------------------------------------------------------
      async function handleImportedFiles(fileList) {
        if (!fileList || fileList.length === 0) return;
        initAudioEngine();

        let importedCount = 0;
        for (const file of Array.from(fileList)) {
          const lower = file.name.toLowerCase();
          try {
            if (lower.endsWith('.mid') || lower.endsWith('.midi')) {
              const buf = await file.arrayBuffer();
              const bytes = new Uint8Array(buf);
              const isMidi = bytes.length >= 4 && bytes[0] === 0x4d && bytes[1] === 0x54 && bytes[2] === 0x68 && bytes[3] === 0x64;
              const midiFolder = state.browserFolders.find((f) => f.id === 'midiloops');
              if (midiFolder) {
                midiFolder.open = true;
                midiFolder.items.unshift({
                  name: file.name,
                  synthType: 'pluck',
                  pitch: 440,
                  isCustomMidi: true,
                  validHeader: isMidi
                });
              }
              state.midiSequences.push({ name: file.name, size: file.size });
              importedCount++;
            } else {
              const arrayBuf = await file.arrayBuffer();
              const decoded = await audioCtx.decodeAudioData(arrayBuf);
              state.customAudioBuffers[file.name] = decoded;

              const sampleFolder = state.browserFolders.find((f) => f.id === 'samples');
              if (sampleFolder) {
                sampleFolder.open = true;
                sampleFolder.items.unshift({
                  name: file.name,
                  synthType: 'kick',
                  pitch: 60,
                  isCustomSample: true
                });
              }

              // Also add a new channel for quick sequencing
              const newIdx = state.channels.length;
              state.channels.push({
                id: newIdx,
                name: file.name.replace(/\.[^/.]+$/, '').slice(0, 12),
                synthType: 'kick',
                freq: 60,
                vol: 0.85,
                pan: 0,
                mute: false,
                solo: false,
                mixerTrack: newIdx % state.mixerStrips.length,
                fx: ['EQ'],
                sampleName: file.name
              });
              state.patterns.forEach((pat) => {
                pat.push(Array.from({ length: NUM_STEPS }, (_, s) => (s % 4 === 0 ? 1 : 0)));
              });
              importedCount++;
            }
          } catch (err) {
            showToast(`Could not decode ${file.name}`);
          }
        }

        if (importedCount > 0) {
          renderBrowser();
          renderChannelRack();
          showToast(`Imported ${importedCount} file(s) into MUSIC PRO`);
        }
      }

