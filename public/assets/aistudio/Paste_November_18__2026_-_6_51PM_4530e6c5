          for (let s = 0; s < NUM_STEPS; s++) {
            const isActive = patternSteps[chIdx][s] === 1;
            const isBeatGroup = Math.floor(s / 4) % 2 === 1;
            const stepBtn = document.createElement('button');
            stepBtn.type = 'button';
            stepBtn.dataset.ch = chIdx;
            stepBtn.dataset.step = s;
            stepBtn.className = `step-pad h-6 sm:h-7 rounded-[3px] border ${
              isActive
                ? 'active'
                : isBeatGroup
                ? 'beat-group border-[#3a4456]'
                : 'bg-[#161a22] border-[#2b3341] hover:border-slate-500'
            }`;

            stepBtn.addEventListener('click', () => {
              if (state.activeTool === 'mute') {
                ch.mute = !ch.mute;
                renderChannelRack();
                return;
              }
              const nextVal = patternSteps[chIdx][s] ? 0 : 1;
              patternSteps[chIdx][s] = nextVal;
              if (nextVal === 1) {
                triggerChannel(chIdx);
              }
              renderChannelRack();
            });

            stepsGrid.appendChild(stepBtn);
          }

          row.appendChild(leftInfo);
          row.appendChild(stepsGrid);
          listEl.appendChild(row);
        });
      }

      function syncMixerInChannel(ch) {
        const strip = state.mixerStrips[ch.mixerTrack];
        if (strip) {
          strip.pan = ch.pan;
          syncMixerNodes();
        }
      }

      function updatePlayheadHighlights() {
        const pads = document.querySelectorAll('.step-pad');
        pads.forEach((pad) => {
          const stepNum = parseInt(pad.dataset.step, 10);
          if (state.isPlaying && stepNum === state.currentStep) {
            pad.classList.add('step-playhead');
          } else {
            pad.classList.remove('step-playhead');
          }
        });

        const playheadEl = document.getElementById('playlistPlayhead');
        if (playheadEl) {
          const leftOffset = 112 + state.playheadBarFloat * PIXELS_PER_BAR;
          playheadEl.style.left = `${leftOffset}px`;
        }

        const bar = Math.floor(state.playheadBarFloat) + 1;
        const beat = (state.currentStep % 4) + 1;
        const subStep = ((state.currentStep % 4) * 1) + 1;
        const counterEl = document.getElementById('timeCounter');
        if (counterEl) {
          counterEl.textContent = `${String(bar).padStart(2, '0')}:${String(beat).padStart(2, '0')}:${String(subStep).padStart(2, '0')}`;
        }
      }

      function renderPlaylist() {
        const rulerEl = document.getElementById('playlistRuler');
        const tracksEl = document.getElementById('playlistTracks');
        if (!rulerEl || !tracksEl) return;

        rulerEl.innerHTML = '';
        for (let b = 1; b <= NUM_BARS; b++) {
          const cell = document.createElement('div');
          cell.style.width = `${PIXELS_PER_BAR}px`;
          cell.className = 'shrink-0 border-r border-[#272f3c] flex items-center justify-center';
          cell.textContent = b;
          rulerEl.appendChild(cell);
        }

        tracksEl.innerHTML = '';
        state.playlistTracks.forEach((track) => {
          const row = document.createElement('div');
          row.className = 'flex h-11 border-b border-[#262e3b] relative';

          const labelCol = document.createElement('div');
          labelCol.className = 'sticky left-0 z-10 w-28 shrink-0 bg-[#1e242e] border-r border-[#2e3642] px-2 flex items-center justify-between text-[11px]';
          labelCol.innerHTML = `<span class="truncate font-medium text-slate-200">${track.name}</span>`;
          row.appendChild(labelCol);

          const lane = document.createElement('div');
          lane.style.width = `${NUM_BARS * PIXELS_PER_BAR}px`;
          lane.className = 'relative shrink-0 h-full';
          lane.style.backgroundImage = `repeating-linear-gradient(to right, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent ${PIXELS_PER_BAR}px)`;

          lane.addEventListener('click', (e) => {
            if (state.activeTool !== 'paint') return;
            const rect = lane.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const rawBar = clickX / PIXELS_PER_BAR;
            const snappedBar = Math.max(0, Math.min(NUM_BARS - 2, Math.floor(rawBar)));
            const patName = document.getElementById('patternSelect')?.selectedOptions?.[0]?.text || 'Pattern Clip';
            state.playlistClips.push({
              id: 'clip_' + Date.now() + '_' + Math.random().toString(16).slice(2, 6),
              track: track.id,
              startBar: snappedBar,
              lengthBars: 2,
              label: patName,
              color: track.color
            });
            renderPlaylist();
            showToast(`Added "${patName}" on ${track.name}`);
          });

          // Render clips on this track
          state.playlistClips
            .filter((c) => c.track === track.id)
            .forEach((clip) => {
              const clipEl = document.createElement('div');
              clipEl.className = 'playlist-clip';
              clipEl.style.left = `${clip.startBar * PIXELS_PER_BAR}px`;
              clipEl.style.width = `${Math.max(24, clip.lengthBars * PIXELS_PER_BAR - 2)}px`;
              clipEl.style.backgroundColor = clip.color;
              clipEl.textContent = clip.label;
              clipEl.title = `${clip.label} (Click to remove)`;
              clipEl.addEventListener('click', (ev) => {
                ev.stopPropagation();
                state.playlistClips = state.playlistClips.filter((item) => item.id !== clip.id);
                renderPlaylist();
                showToast('Removed clip from playlist');
              });
              lane.appendChild(clipEl);
            });

          row.appendChild(lane);
          tracksEl.appendChild(row);
        });
      }

      function renderMixer() {
        const container = document.getElementById('mixerChannels');
        if (!container) return;
        container.innerHTML = '';

        state.mixerStrips.forEach((strip, idx) => {
          const card = document.createElement('div');
          card.className = 'shrink-0 w-20 rounded-md bg-[#222833] border border-[#303948] px-1.5 py-1 flex flex-col justify-between';

          const top = document.createElement('div');
          top.className = 'text-center';
          top.innerHTML = `
            <div class="text-[10px] font-semibold text-slate-200 truncate">${strip.name}</div>
            <div class="mt-0.5 space-y-0.5">
              ${strip.fxSlots
                .map(
                  (fx) =>
                    `<div class="rounded bg-[#141820] border border-[#2d3645] text-[8px] font-mono-num text-sky-300 py-0.5">${fx}</div>`
                )
                .join('')}
            </div>
          `;

          const mid = document.createElement('div');
          mid.className = 'flex items-center justify-center gap-1.5 my-0.5';

          const meterWrap = document.createElement('div');
          meterWrap.className = 'w-2.5 h-16 bg-[#0e1218] rounded-xs border border-[#2c3544] overflow-hidden flex flex-col justify-end';
          const meterBar = document.createElement('div');
          meterBar.id = `mixerMeter_${idx}`;
          meterBar.className = 'w-full bg-gradient-to-t from-emerald-500 via-amber-400 to-rose-500';
          meterBar.style.height = '12%';
          meterWrap.appendChild(meterBar);

          const fader = document.createElement('input');
          fader.type = 'range';
          fader.min = '0';
          fader.max = '1';
          fader.step = '0.01';
          fader.value = strip.vol;
          fader.className = 'mixer-fader h-16';
          fader.addEventListener('input', (e) => {
            strip.vol = parseFloat(e.target.value);
            syncMixerNodes();
          });

          mid.appendChild(meterWrap);
          mid.appendChild(fader);

          const bot = document.createElement('div');
          bot.className = 'flex flex-col items-center gap-1';

          const panInput = document.createElement('input');
          panInput.type = 'range';
          panInput.min = '-1';
          panInput.max = '1';
          panInput.step = '0.05';
          panInput.value = strip.pan;
          panInput.title = 'Stereo Pan';
          panInput.className = 'mini-slider w-14';
          panInput.addEventListener('input', (e) => {
            strip.pan = parseFloat(e.target.value);
            syncMixerNodes();
          });

          const muteBtn = document.createElement('button');
          muteBtn.type = 'button';
          muteBtn.textContent = strip.mute ? 'MUTE' : 'ON';
          muteBtn.className = `w-full rounded py-0.5 text-[9px] font-bold cursor-pointer ${
            strip.mute ? 'bg-rose-500/80 text-white' : 'bg-[#171c24] text-emerald-400 hover:bg-[#2a3240]'
          }`;
          muteBtn.addEventListener('click', () => {
            strip.mute = !strip.mute;
            syncMixerNodes();
            renderMixer();
          });

          bot.appendChild(panInput);
          bot.appendChild(muteBtn);

          card.appendChild(top);
          card.appendChild(mid);
          card.appendChild(bot);
          container.appendChild(card);
        });
      }

      // -------------------------------------------------------------------
      // 5. RESPONSIVE SPECTRUM ANALYZER & 60 FPS MAIN ANIMATION LOOP
      // -------------------------------------------------------------------
      const specCanvas = document.getElementById('spectrumCanvas');
      const specCtx = specCanvas ? specCanvas.getContext('2d') : null;

      function resizeSpectrumCanvas() {
        if (!specCanvas || !specCtx) return;
        const parent = specCanvas.parentElement;
        if (!parent) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const width = parent.clientWidth;
        const height = parent.clientHeight;
        if (specCanvas.width !== Math.floor(width * dpr) || specCanvas.height !== Math.floor(height * dpr)) {
          specCanvas.width = Math.floor(width * dpr);
          specCanvas.height = Math.floor(height * dpr);
          specCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
      }

      function drawSpectrumAndMeters(dt) {
        resizeSpectrumCanvas();
        if (!specCanvas || !specCtx) return;

        const w = specCanvas.clientWidth;
        const h = specCanvas.clientHeight;

        specCtx.clearRect(0, 0, w, h);

        // Background grid lines
        specCtx.strokeStyle = 'rgba(56, 189, 248, 0.12)';
        specCtx.lineWidth = 1;
        for (let gx = 0; gx < w; gx += 32) {
          specCtx.beginPath();
          specCtx.moveTo(gx, 0);
          specCtx.lineTo(gx, h);
          specCtx.stroke();
        }
        for (let gy = 0; gy < h; gy += 24) {
          specCtx.beginPath();
          specCtx.moveTo(0, gy);
          specCtx.lineTo(w, gy);
          specCtx.stroke();
        }

        let hasLiveData = false;
        if (analyserNode && freqDataArray && timeDataArray && state.isPlaying) {
          analyserNode.getByteFrequencyData(freqDataArray);
          analyserNode.getByteTimeDomainData(timeDataArray);
          hasLiveData = true;
        }

        const barCount = 48;
        const gap = 3;
        const barWidth = Math.max(2, (w - gap * (barCount - 1)) / barCount);

        let maxLevel = 0.04;

        for (let i = 0; i < barCount; i++) {
          let norm = 0.05;
          if (hasLiveData && freqDataArray) {
            const binIdx = Math.min(freqDataArray.length - 1, Math.floor((i / barCount) * freqDataArray.length * 0.75));
            norm = freqDataArray[binIdx] / 255;
          } else if (state.isPlaying) {
            // Smooth procedural reactive wave when playing
            const wave = Math.sin(performance.now() * 0.008 + i * 0.35) * 0.5 + 0.5;
            norm = 0.12 + wave * 0.35 * (1 - i / (barCount * 1.3));
          } else {
            // Subtle idle breath
            norm = 0.05 + 0.03 * Math.abs(Math.sin(performance.now() * 0.002 + i * 0.2));
          }

          if (norm > maxLevel) maxLevel = norm;

          const barHeight = Math.max(3, norm * (h - 18));
          const x = i * (barWidth + gap);
          const y = h - barHeight;

          const grad = specCtx.createLinearGradient(0, y, 0, h);
          grad.addColorStop(0, '#7dd3fc');
          grad.addColorStop(0.5, '#38bdf8');
          grad.addColorStop(1, '#0284c7');

          specCtx.fillStyle = grad;
          specCtx.fillRect(x, y, barWidth, barHeight);
        }

        // Waveform overlay line
        specCtx.beginPath();
        for (let x = 0; x < w; x += 4) {
          let sampleNorm = 0;
          if (hasLiveData && timeDataArray) {
            const idx = Math.min(timeDataArray.length - 1, Math.floor((x / w) * timeDataArray.length));
            sampleNorm = (timeDataArray[idx] - 128) / 128;
          } else if (state.isPlaying) {
            sampleNorm = Math.sin(x * 0.05 + performance.now() * 0.014) * 0.22;
          }
          const py = h * 0.52 + sampleNorm * (h * 0.34);
          if (x === 0) specCtx.moveTo(x, py);
          else specCtx.lineTo(x, py);
        }
        specCtx.strokeStyle = 'rgba(224, 242, 254, 0.75)';
        specCtx.lineWidth = 1.4;
        specCtx.stroke();

        // Peak readout text
        const peakEl = document.getElementById('peakReadout');
        if (peakEl) {
          const db = maxLevel > 0.05 ? (20 * Math.log10(maxLevel)).toFixed(1) : '-24.0';
          peakEl.textContent = `${db} dB`;
        }

        // Decay & draw mixer meters
        let masterPeak = 0.06;
        state.mixerStrips.forEach((strip, idx) => {
          strip.peak = Math.max(0.05, strip.peak - dt * 1.8);
          const activeVal = state.isPlaying ? Math.max(strip.peak, maxLevel * 0.65 * strip.vol) : strip.peak;
          if (activeVal > masterPeak) masterPeak = activeVal;

          const el = document.getElementById(`mixerMeter_${idx}`);
          if (el) {
            el.style.height = `${Math.min(100, Math.round(activeVal * 100))}%`;
          }
        });

        const mL = document.getElementById('masterMeterL');
        const mR = document.getElementById('masterMeterR');
        const mPct = Math.min(100, Math.round(masterPeak * state.masterVolume * 115));
        if (mL) mL.style.height = `${mPct}%`;
        if (mR) mR.style.height = `${Math.max(4, mPct - 4)}%`;
      }

      // Sequencer clock & 60 FPS loop
      let lastFrameTime = performance.now();
      let stepAccumulatorSec = 0;
      let fpsFrames = 0;
      let fpsTimer = 0;

      function mainLoop(now) {
        const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
        lastFrameTime = now;

        // FPS counter badge
        fpsFrames++;
        fpsTimer += dt;
        if (fpsTimer >= 0.5) {
          const fpsBadge = document.getElementById('fpsBadge');
          if (fpsBadge) {
            const measuredFps = Math.round(fpsFrames / fpsTimer);
            fpsBadge.textContent = `${measuredFps} FPS`;
          }
          fpsFrames = 0;
          fpsTimer = 0;
        }

        if (state.isPlaying) {
          // 16th note step duration: 60 / BPM / 4
          const secondsPerStep = 60 / Math.max(40, state.bpm) / 4;
          stepAccumulatorSec += dt;

          while (stepAccumulatorSec >= secondsPerStep) {
            stepAccumulatorSec -= secondsPerStep;

            // Trigger active steps in current pattern
            const pat = state.patterns[state.activePattern];
            if (pat) {
              state.channels.forEach((ch, idx) => {
                if (pat[idx] && pat[idx][state.currentStep] === 1) {
                  triggerChannel(idx);
                }
              });
            }

            updatePlayheadHighlights();
            state.currentStep = (state.currentStep + 1) % NUM_STEPS;
          }

          // Advance smooth playlist playhead (1 bar = 4 beats = 16 steps)
          const barsPerSecond = Math.max(40, state.bpm) / 60 / 4;
          state.playheadBarFloat = (state.playheadBarFloat + barsPerSecond * dt) % NUM_BARS;
          updatePlayheadHighlights();
        }

        drawSpectrumAndMeters(dt);
        requestAnimationFrame(mainLoop);
      }

      // -------------------------------------------------------------------
      // 6. EVENT BINDINGS & INITIALIZATION
      // -------------------------------------------------------------------
      function bindEvents() {
        const btnPlay = document.getElementById('btnPlay');
        const btnStop = document.getElementById('btnStop');
        const btnRecord = document.getElementById('btnRecord');
        const bpmInput = document.getElementById('bpmInput');
        const patternSelect = document.getElementById('patternSelect');
        const btnClearPattern = document.getElementById('btnClearPattern');
        const btnAddChannel = document.getElementById('btnAddChannel');
        const btnAddClip = document.getElementById('btnAddClip');
        const masterFader = document.getElementById('masterFader');
        const masterDbLabel = document.getElementById('masterDbLabel');
        const fileInput = document.getElementById('fileUploadInput');
        const dropZone = document.getElementById('dropZone');

        btnPlay?.addEventListener('click', () => {
          initAudioEngine();
          state.isPlaying = !state.isPlaying;
          const label = document.getElementById('playLabel');
          const icon = document.getElementById('playIcon');
          if (state.isPlaying) {
            stepAccumulatorSec = 0;
            if (label) label.textContent = 'PAUSE';
            if (icon) icon.innerHTML = '<rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect>';
            btnPlay.classList.replace('bg-emerald-600', 'bg-amber-500');
            btnPlay.classList.replace('hover:bg-emerald-500', 'hover:bg-amber-400');
          } else {
            if (label) label.textContent = 'PLAY';
            if (icon) icon.innerHTML = '<polygon points="5,3 19,12 5,21"></polygon>';
            btnPlay.classList.replace('bg-amber-500', 'bg-emerald-600');
            btnPlay.classList.replace('hover:bg-amber-400', 'hover:bg-emerald-500');
            updatePlayheadHighlights();
          }
        });

        btnStop?.addEventListener('click', () => {
          state.isPlaying = false;
          state.currentStep = 0;
          state.playheadBarFloat = 0;
          stepAccumulatorSec = 0;
          const label = document.getElementById('playLabel');
          const icon = document.getElementById('playIcon');
          if (label) label.textContent = 'PLAY';
          if (icon) icon.innerHTML = '<polygon points="5,3 19,12 5,21"></polygon>';
          btnPlay?.classList.remove('bg-amber-500', 'hover:bg-amber-400');
          btnPlay?.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
          updatePlayheadHighlights();
        });

        btnRecord?.addEventListener('click', () => {
          initAudioEngine();
          state.isRecording = !state.isRecording;
          const dot = document.getElementById('recDot');
          if (state.isRecording) {
            dot?.classList.add('animate-ping');
            showToast('Recording Mode Armed');
          } else {
            dot?.classList.remove('animate-ping');
            showToast('Recording Mode Off');
          }
        });

        bpmInput?.addEventListener('input', (e) => {
          const val = parseFloat(e.target.value);
          if (!Number.isNaN(val) && val >= 40 && val <= 260) {
            state.bpm = val;
          }
        });

        patternSelect?.addEventListener('change', (e) => {
          state.activePattern = parseInt(e.target.value, 10) || 0;
          renderChannelRack();
          showToast(`Switched to ${e.target.selectedOptions[0].text}`);
        });

        btnClearPattern?.addEventListener('click', () => {
          state.patterns[state.activePattern] = state.channels.map(() => Array(NUM_STEPS).fill(0));
          renderChannelRack();
          showToast('Cleared active pattern steps');
        });

        btnAddChannel?.addEventListener('click', () => {
          const idx = state.channels.length;
          const synthChoices = ['kick', 'snare', 'hat', '808', 'pluck', 'lead'];
          const synthType = synthChoices[idx % synthChoices.length];
          const freqMap = { kick: 60, snare: 220, hat: 8200, '808': 55, pluck: 440, lead: 659.25 };

          state.channels.push({
            id: idx,
            name: `Synth ${idx + 1}`,
            synthType,
            freq: freqMap[synthType] || 440,
            vol: 0.78,
            pan: 0,
            mute: false,
            solo: false,
            mixerTrack: idx % state.mixerStrips.length,
            fx: ['EQ']
          });
          state.patterns.forEach((pat) => {
            pat.push(Array(NUM_STEPS).fill(0));
          });
          renderChannelRack();
          showToast(`Added Synth ${idx + 1} to Channel Rack`);
        });

        btnAddClip?.addEventListener('click', () => {
          const startBar = Math.min(NUM_BARS - 2, Math.floor(state.playheadBarFloat));
          const trackIdx = state.activePattern % state.playlistTracks.length;
          const patName = patternSelect?.selectedOptions?.[0]?.text || 'Pattern Clip';
          state.playlistClips.push({
            id: 'clip_' + Date.now(),
            track: trackIdx,
            startBar,
            lengthBars: 2,
            label: patName,
            color: CLIP_COLORS[state.activePattern % CLIP_COLORS.length]
          });
          renderPlaylist();
          showToast(`Placed "${patName}" at Bar ${startBar + 1}`);
        });

        masterFader?.addEventListener('input', (e) => {
          state.masterVolume = parseFloat(e.target.value);
          if (masterDbLabel) {
            masterDbLabel.textContent = `${Math.round(state.masterVolume * 100)}%`;
          }
          syncMixerNodes();
        });

        // Tool buttons
        document.querySelectorAll('.tool-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const tool = btn.dataset.tool;
            state.activeTool = tool;
            document.querySelectorAll('.tool-btn').forEach((b) => {
              b.className = 'tool-btn rounded px-2 py-1 text-[11px] font-semibold text-slate-300 hover:bg-[#232a36] cursor-pointer';
            });
            btn.className = 'tool-btn rounded px-2 py-1 text-[11px] font-semibold bg-sky-500/20 text-sky-300 border border-sky-400/40 cursor-pointer';
            if (tool === 'paint') {
              showToast('Paint Tool active: Tap any Playlist lane to place a clip');
            } else if (tool === 'mute') {
              showToast('Mute Tool active: Tap any step or channel to mute');
            }
          });
        });

        document.getElementById('snapSelect')?.addEventListener('change', (e) => {
          state.snapDivision = parseInt(e.target.value, 10) || 2;
        });

        // File input & Drag/Drop
        fileInput?.addEventListener('change', (e) => {
          handleImportedFiles(e.target.files);
          e.target.value = '';
        });

        if (dropZone) {
          ['dragenter', 'dragover'].forEach((evtName) => {
            dropZone.addEventListener(evtName, (e) => {
              e.preventDefault();
              dropZone.classList.add('border-sky-400', 'bg-sky-950/30');
            });
          });
          ['dragleave', 'drop'].forEach((evtName) => {
            dropZone.addEventListener(evtName, (e) => {
              e.preventDefault();
              dropZone.classList.remove('border-sky-400', 'bg-sky-950/30');
            });
          });
          dropZone.addEventListener('drop', (e) => {
            if (e.dataTransfer && e.dataTransfer.files) {
              handleImportedFiles(e.dataTransfer.files);
            }
          });
        }

        // Mobile pane tabs
        const paneIds = ['pane-browser', 'pane-sequencer', 'pane-playlist', 'pane-mixer'];
        document.querySelectorAll('.mobile-tab-btn').forEach((tabBtn) => {
          tabBtn.addEventListener('click', () => {
            const target = tabBtn.dataset.pane;
            document.querySelectorAll('.mobile-tab-btn').forEach((b) => {
              b.classList.remove('active-tab');
              b.classList.add('bg-[#222833]', 'text-slate-300');
            });
            tabBtn.classList.add('active-tab');
            tabBtn.classList.remove('bg-[#222833]', 'text-slate-300');

            if (target === 'all') {
              paneIds.forEach((id) => document.getElementById(id)?.classList.remove('hidden'));
            } else {
              paneIds.forEach((id) => {
                const el = document.getElementById(id);
                if (!el) return;
                if (id === `pane-${target}`) el.classList.remove('hidden');
                else el.classList.add('hidden');
              });
            }
            resizeSpectrumCanvas();
          });
        });

        // Spacebar Play/Pause shortcut
        window.addEventListener('keydown', (e) => {
          if (e.code === 'Space' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'SELECT') {
            e.preventDefault();
            btnPlay?.click();
          }
        });

        window.addEventListener('resize', resizeSpectrumCanvas);
      }

      // Initial render and start loop
      renderBrowser();
      renderChannelRack();
      renderPlaylist();
      renderMixer();
      updatePlayheadHighlights();
      bindEvents();
      requestAnimationFrame(mainLoop);
    })();
  </script>
</body>
</html>