export interface MarineInventoryItem {
  id: string;
  name: string;
  icon: string;
  quantity: number;
  category: string;
  speciesId?: string;
}

export function addMarineInventoryItem(
  inventory: MarineInventoryItem[],
  newItem: MarineInventoryItem
): MarineInventoryItem[] {

  const existing = inventory.find(
    item => item.id === newItem.id
  );

  if (existing) {
    return inventory.map(item =>
      item.id === newItem.id
        ? {
            ...item,
            quantity: item.quantity + newItem.quantity
          }
        : item
    );
  }

  return [...inventory, { ...newItem }];
}

