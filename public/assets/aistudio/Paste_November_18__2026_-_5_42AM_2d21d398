export function getUnderwaterVisualSettings(
  depth: number
): UnderwaterVisualSettings {

  if (depth < 10) {
    return {
      waterColor: "#62B9D5",
      visibility: 100,
      lightIntensity: 1,
      fogDensity: 0.002
    };
  }

  if (depth < 50) {
    return {
      waterColor: "#176D9B",
      visibility: 65,
      lightIntensity: 0.75,
      fogDensity: 0.008
    };
  }

  if (depth < 150) {
    return {
      waterColor: "#10446F",
      visibility: 35,
      lightIntensity: 0.45,
      fogDensity: 0.018
    };
  }

  if (depth < 500) {
    return {
      waterColor: "#092844",
      visibility: 15,
      lightIntensity: 0.2,
      fogDensity: 0.035
    };
  }

  return {
    waterColor: "#030D1C",
    visibility: 5,
    lightIntensity: 0.06,
    fogDensity: 0.06
  };
}

