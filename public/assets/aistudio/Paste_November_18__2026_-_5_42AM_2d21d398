// ============================================================
// 1. TYPES
// ============================================================

export type MarineHabitat =
  | "open_ocean"
  | "deep_ocean"
  | "coral_reef"
  | "coastal_water"
  | "tropical_ocean"
  | "cold_ocean"
  | "polar_water"
  | "seagrass"
  | "mangrove"
  | "estuary"
  | "seabed"
  | "shoreline"
  | "beach"
  | "freshwater";

export type MarineBehavior =
  | "peaceful"
  | "schooling"
  | "predator"
  | "territorial"
  | "bottom_dweller"
  | "filter_feeder"
  | "slow_drifter";

export interface MarineSpecies {
  id: string;
  name: string;
  habitat: MarineHabitat[];
  behavior: MarineBehavior;
  minDepth: number;
  maxDepth: number;
  swimSpeed: number;
  schoolSize: number;
  collectible: boolean;
  harvestable: boolean;
  predator: boolean;
  icon: string;
  color: string;
}

