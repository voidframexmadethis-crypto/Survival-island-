// ============================================================
// 3. HABITAT SPAWNING
// ============================================================

export interface MarineSpawnPoint {
  x: number;
  y: number;
  z: number;
  depth: number;
  habitat: MarineHabitat;
}

export function getMarineSpeciesForHabitat(
  habitat: MarineHabitat,
  depth: number
): MarineSpecies[] {

  return MARINE_SPECIES.filter(species =>
    species.habitat.includes(habitat) &&
    depth >= species.minDepth &&
    depth <= species.maxDepth
  );
}

// ============================================================
// 4. NATURAL SLOW SWIMMING
// ============================================================

export interface MarineAnimalState {
  id: string;
  speciesId: string;
  x: number;
  y: number;
  z: number;
  direction: number;
  targetDirection: number;
  speed: number;
  turnTimer: number;
  alive: boolean;
}

export function createMarineAnimal(
  species: MarineSpecies,
  position: { x: number; y: number; z: number }
): MarineAnimalState {

  return {
    id: `${species.id}_${Math.random().toString(36).slice(2)}`,
    speciesId: species.id,
    x: position.x,
    y: position.y,
    z: position.z,
    direction: Math.random() * Math.PI * 2,
    targetDirection: Math.random() * Math.PI * 2,
    speed: species.swimSpeed,
    turnTimer: 2 + Math.random() * 5,
    alive: true
  };
}

export function updateMarineAnimal(
  animal: MarineAnimalState,
  deltaTime: number
): MarineAnimalState {

  if (!animal.alive) return animal;

  const dt = Math.min(deltaTime, 0.05);

  animal.turnTimer -= dt;

  if (animal.turnTimer <= 0) {
    animal.targetDirection +=
      (Math.random() - 0.5) * 0.8;

    animal.turnTimer = 3 + Math.random() * 5;
  }

  let directionDifference =
    animal.targetDirection - animal.direction;

  directionDifference = Math.atan2(
    Math.sin(directionDifference),
    Math.cos(directionDifference)
  );

  animal.direction +=
    directionDifference * Math.min(dt * 0.35, 1);

  animal.x +=
    Math.cos(animal.direction) * animal.speed * dt;

  animal.z +=
    Math.sin(animal.direction) * animal.speed * dt;

  // Gentle vertical swimming.
  animal.y += Math.sin(
    animal.x * 0.15 + animal.z * 0.15
  ) * animal.speed * dt * 0.12;

  return animal;
}

// ============================================================
// 5. FISH SCHOOL FORMATION
// ============================================================

export interface MarineSchool {
  leaderId: string;
  members: string[];
  spacing: number;
}

export function calculateSchoolPosition(
  leader: MarineAnimalState,
  memberIndex: number,
  school: MarineSchool
) {

  const angle =
    leader.direction +
    Math.PI +
    (memberIndex % 5) * 0.35;

  const distance =
    school.spacing * (1 + Math.floor(memberIndex / 5));

  return {
    x: leader.x + Math.cos(angle) * distance,
    y: leader.y + Math.sin(memberIndex) * 0.3,
    z: leader.z + Math.sin(angle) * distance
  };
}

