export interface MarineBaby {
  id: string;
  speciesId: string;
  parentIds: string[];
  bornAt: number;
  growth: number;
  mature: boolean;
}

export function createMarineBaby(
  speciesId: string,
  parentIds: string[]
): MarineBaby {

  return {
    id: `baby_${speciesId}_${Date.now()}_${Math.random()}`,
    speciesId,
    parentIds,
    bornAt: Date.now(),
    growth: 0,
    mature: false
  };
}

export function updateMarineBaby(
  baby: MarineBaby,
  elapsedDays: number,
  maturityDays: number
): MarineBaby {

  baby.growth = Math.min(
    1,
    elapsedDays / maturityDays
  );

  baby.mature = baby.growth >= 1;

  return baby;
}

